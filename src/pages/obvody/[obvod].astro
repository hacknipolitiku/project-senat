---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { formatCzechName, getPartyLogoFiles } from "../../lib/data";
import {
  getAssetUrl,
  getCandidateFormUrl,
  getHomepageUrl,
  getInstagramUrl,
  getPartyLogoUrl,
  getTwitterUrl,
} from "../../lib/links";

export async function getStaticPaths() {
  const [districtEntries, candidateEntries] = await Promise.all([
    getCollection("districts"),
    getCollection("candidates"),
  ]);
  return districtEntries.map((district) => ({
    params: { obvod: district.data.slug },
    props: {
      district: {
        id: district.data.id,
        name: district.data.name,
        candidates: candidateEntries
          .filter((e) => e.data.districtId === district.data.id)
          .sort((a, b) => a.data.candidateNumber - b.data.candidateNumber),
      },
    },
  }));
}

const { district } = Astro.props;
---

<Layout
  title={`Obvod ${district.id} – ${district.name}`}
  description={`Kandidáti v obvodu ${district.id} ${district.name}`}
>
  <nav class="text-sm mb-6">
    <a
      href={getHomepageUrl()}
      class="font-semibold transition-opacity hover:opacity-70"
      style="color: #2a2b66;">← Přehled obvodů</a
    >
  </nav>

  <div class="mb-8">
    <div class="flex items-center gap-3 mb-1">
      <span
        class="inline-flex items-center justify-center w-10 h-10 rounded-full text-sm font-bold"
        style="background-color: #2a2b66; color: white; border: 2px solid #fa1a5b;"
      >
        {district.id}
      </span>
      <h1 class="text-3xl font-bold" style="color: #2a2b66;">
        {district.name}
      </h1>
    </div>
    <p class="text-gray-500 ml-13">{district.candidates.length} kandidátů</p>
  </div>

  <div class="grid gap-3">
    {
      district.candidates.map((c) => {
        const declarationLabel =
          c.data.gender === "f" ? "Podepsala deklaraci" : "Podepsal deklaraci";
        return (
          <div class="block rounded-lg px-4 py-3 border-1 border-blue-900">
            <div class="flex items-start gap-4">
              <div class="w-6 text-center">
                <span class="text-xs text-gray-400 font-mono">
                  #{c.data.candidateNumber}
                </span>
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-semibold text-gray-900">
                    {formatCzechName(c.data.name)}
                  </span>
                  {getPartyLogoFiles(c.data.electoralParty).length > 0 ? (
                    getPartyLogoFiles(c.data.electoralParty).map((logo) => (
                      <img
                        src={getPartyLogoUrl(logo)}
                        alt={logo.replace(".svg", "")}
                        class="h-5 w-auto"
                      />
                    ))
                  ) : (
                    <span>{c.data.electoralParty}</span>
                  )}
                </div>
                <div class="mt-1 text-sm text-gray-500 flex flex-wrap items-center gap-x-3 gap-y-0.5">
                  <span>{c.data.occupation}</span>
                  <span>·</span>
                  <span>{c.data.residence}</span>
                </div>
                {(c.data.hlidacStatuUrl ||
                  c.data.twitter ||
                  c.data.instagram ||
                  c.data.signedDeclaration) && (
                  <div class="mt-2 flex items-center gap-3 flex-wrap">
                    {c.data.hlidacStatuUrl && (
                      <a
                        href={c.data.hlidacStatuUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        title="Profil na Hlídači státu"
                        aria-label="Hlídač státu"
                        class="transition-opacity hover:opacity-70"
                      >
                        <img
                          src={getAssetUrl("logos/hlidac-statu.png")}
                          alt="Hlídač státu"
                          class="h-5 w-auto"
                        />
                      </a>
                    )}
                    {c.data.twitter && (
                      <a
                        href={getTwitterUrl(c.data.twitter)}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`Twitter/X @${c.data.twitter}`}
                        aria-label="Twitter/X"
                        class="text-gray-500 transition-colors hover:text-gray-900"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="h-4 w-4"
                          aria-hidden="true"
                        >
                          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                        </svg>
                      </a>
                    )}
                    {c.data.instagram && (
                      <a
                        href={getInstagramUrl(c.data.instagram)}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`Instagram @${c.data.instagram}`}
                        aria-label="Instagram"
                        class="text-gray-500 transition-colors hover:text-gray-900"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="h-4 w-4"
                          aria-hidden="true"
                        >
                          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                        </svg>
                      </a>
                    )}
                    {c.data.signedDeclaration && (
                      <span
                        title={declarationLabel}
                        class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium"
                        style="background-color: #2a2b6614; color: #2a2b66;"
                      >
                        <svg
                          viewBox="0 0 20 20"
                          fill="currentColor"
                          class="h-3.5 w-3.5"
                          aria-hidden="true"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 011.42-1.42l2.79 2.79 6.79-6.79a1 1 0 011.42 0z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        {declarationLabel}
                      </span>
                    )}
                  </div>
                )}
              </div>
              {c.data.showForm && (
                <a
                  href={getCandidateFormUrl(formatCzechName(c.data.name))}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ml-auto self-center shrink-0 rounded-md px-3 py-1.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
                  style="background-color: #fa1a5b;"
                >
                  Zapojit se do kampaně
                </a>
              )}
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- The back button on bottom is only visible on mobile -->
  <nav class="text-sm mb-6 mt-12 sm:hidden">
    <a
      href={getHomepageUrl()}
      class="font-semibold transition-opacity hover:opacity-70"
      style="color: #2a2b66;">← Přehled obvodů</a
    >
  </nav>
</Layout>
