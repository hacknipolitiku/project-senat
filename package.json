{
  "name": "senat-2026-web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "cli": "node ./src/bin/cli.ts",
    "data:prepare": "node ./src/bin/cli.ts data:prepare",
    "build": "astro build",
    "build:all": "pnpm run data:prepare && pnpm run build",
    "preview": "astro preview",
    "astro": "astro",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^6.4.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.58.0",
    "tailwindcss": "^4.1.0"
  },
  "packageManager": "pnpm@11.0.8"
}
